# Database Configuration
# For local Windows installation, use standard defaults.
# Postgres default user is 'postgres'. Set your password during installation.
DATABASE_URL="postgresql://postgres:password123@localhost:5432/healthcare_db?schema=public"

# MongoDB default installation usually has no auth on localhost.
MONGODB_URI="mongodb://localhost:27017/healthcare_db"

# JWT Secret for Auth
JWT_SECRET="your_super_secret_jwt_key_here"

# Server Port
PORT=5000
